{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:8787",
        "EXPO_PUBLIC_SHARE_ORIGIN": "http://localhost:8081",
        "EXPO_PUBLIC_ENV": "development"
      }
    },
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://tophunt-social-api-staging.weadown-in.workers.dev",
        "EXPO_PUBLIC_SHARE_ORIGIN": "https://tophunt-social-staging.pages.dev",
        "EXPO_PUBLIC_ENV": "staging"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://tophunt-social-api.weadown-in.workers.dev",
        "EXPO_PUBLIC_SHARE_ORIGIN": "https://tophunt-social.pages.dev",
        "EXPO_PUBLIC_ENV": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
